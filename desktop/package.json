{
  "name": "pulse-desktop",
  "productName": "Pulse",
  "version": "1.0.0",
  "description": "Pulse: a QR code you can hear. Desktop app that listens in the background and saves the links it hears.",
  "author": "DurHack 2026 Pulse team",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.durhack.pulse",
    "productName": "Pulse",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      {
        "from": "../pulse1",
        "to": "pulse1",
        "filter": [
          "index.html",
          "app.js",
          "pulse.js",
          "icon.svg",
          "icon-192.png",
          "icon-512.png"
        ]
      }
    ],
    "win": {
      "icon": "../pulse1/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Pulse-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Pulse-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "../pulse1/icon-512.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pulse listens for sound pulses that carry website links."
      }
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
